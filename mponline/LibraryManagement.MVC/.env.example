# ==============================================================
# Library Management System — Environment Configuration
# ==============================================================
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to source control.
# ==============================================================

# PostgreSQL / Supabase connection string
# Local SQL Server example:
#   Host=localhost;Port=5432;Database=library_db;Username=postgres;Password=your_password;
# Supabase pooler example:
#   Host=aws-0-ap-south-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.<project-ref>;Password=your_password;Pooling=false;

DATABASE_URL="Host=localhost;Port=5432;Database=library_db;Username=postgres;Password=your_password_here;"
