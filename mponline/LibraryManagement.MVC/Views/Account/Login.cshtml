@model LibraryManagement.MVC.ViewModels.LoginViewModel

@{
    Layout = null; // No sidebar/navbar on the login screen
    ViewData["Title"] = "Login - Library Management System";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <style>
        body {
            background: linear-gradient(135deg, #f3e8ff 0%, #e0e7ff 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', sans-serif;
        }
        .login-card {
            border: none;
            border-radius: 1rem;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            background: #ffffff;
            overflow: hidden;
            width: 100%;
            max-width: 450px;
        }
        .login-header {
            background: linear-gradient(90deg, #6366f1, #8b5cf6);
            padding: 2rem 1.5rem;
            text-align: center;
            color: white;
        }
        .login-body {
            padding: 2.5rem 2rem;
        }
        .brand-icon {
            font-size: 3rem;
            margin-bottom: 0.5rem;
        }
        .form-control {
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
        }
        .btn-primary {
            background: #6366f1;
            border: none;
            padding: 0.75rem;
            border-radius: 0.5rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }
        .btn-primary:hover {
            background: #4f46e5;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(99,102,241,0.2);
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="login-header">
            <div class="brand-icon">
                <i class="bi bi-book-half"></i>
            </div>
            <h3 class="fw-bold mb-0">LibraryMS</h3>
            <p class="text-white-50 mb-0 small">Admin Portal Login</p>
        </div>
        
        <div class="login-body">
            <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                
                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-4 rounded-3 border-0"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-bold text-secondary">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                        <input asp-for="Email" class="form-control border-start-0 ps-0 bg-light" placeholder="admin@library.com" required autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label fw-bold text-secondary">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                        <input asp-for="Password" class="form-control border-start-0 ps-0 bg-light" placeholder="••••••••" required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4 d-flex justify-content-between align-items-center">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-secondary small">Remember me</label>
                    </div>
                    <a href="#" class="text-decoration-none small text-primary fw-bold">Forgot Password?</a>
                </div>

                <button type="submit" class="btn btn-primary w-100 d-flex justify-content-center align-items-center gap-2">
                    <span>Sign In</span>
                    <i class="bi bi-box-arrow-in-right"></i>
                </button>
                
                <div class="text-center mt-4">
                    <p class="text-muted small mb-0">Demo Credentials: <strong>admin@library.com</strong> / <strong>admin</strong></p>
                </div>
            </form>
        </div>
    </div>

</body>
</html>
