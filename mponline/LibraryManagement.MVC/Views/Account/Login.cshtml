@model LibraryManagement.MVC.ViewModels.LoginViewModel

@{
    Layout = null; // No sidebar/navbar on the login screen
    ViewData["Title"] = "Login - Library Management System";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <style>
        body {
            background: linear-gradient(135deg, #f3e8ff 0%, #e0e7ff 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', sans-serif;
        }
        .login-card {
            border: none;
            border-radius: 1rem;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            background: #ffffff;
            overflow: hidden;
            width: 100%;
            max-width: 450px;
        }
        .login-header {
            background: linear-gradient(90deg, #6366f1, #8b5cf6);
            padding: 2rem 1.5rem;
            text-align: center;
            color: white;
        }
        .login-body {
            padding: 2.5rem 2rem;
        }
        .brand-icon {
            font-size: 3rem;
            margin-bottom: 0.5rem;
        }
        .form-control {
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
        }
        .btn-primary {
            background: #6366f1;
            border: none;
            padding: 0.75rem;
            border-radius: 0.5rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }
        .btn-primary:hover {
            background: #4f46e5;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(99,102,241,0.2);
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="login-header text-center">
            <div class="brand-icon d-inline-block bg-white text-primary rounded-circle p-3 mb-3 shadow-sm" style="width: 80px; height: 80px; line-height: 50px;">
                <i class="bi bi-book-half"></i>
            </div>
            <h3 class="fw-bold mb-1">Central Library</h3>
            <p class="text-white-50 mb-0 small text-uppercase fw-bold letter-spacing-1">Secure Login Portal</p>
        </div>
        
        <div class="login-body">
            <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                
                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-4 rounded-3 border-0 bg-danger bg-opacity-10 text-danger fw-bold text-center"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-bold text-secondary">Email Address / Username</label>
                    <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden">
                        <span class="input-group-text bg-white border-end-0 text-primary"><i class="bi bi-person-fill"></i></span>
                        <input asp-for="Email" class="form-control border-start-0 ps-0 text-dark fw-500" placeholder="e.g. admin@library.com" required autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block fw-bold"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label fw-bold text-secondary">Password</label>
                    <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden">
                        <span class="input-group-text bg-white border-end-0 text-primary"><i class="bi bi-lock-fill"></i></span>
                        <input asp-for="Password" class="form-control border-start-0 ps-0 text-dark fw-500" placeholder="••••••••" required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block fw-bold"></span>
                </div>

                <div class="mb-4 d-flex justify-content-between align-items-center px-1">
                    <div class="form-check form-switch">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="RememberMe" class="form-check-label text-secondary small fw-bold">Remember me</label>
                    </div>
                    <a href="#" class="text-decoration-none small text-primary fw-bold hover-primary">Forgot Password?</a>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 d-flex justify-content-center align-items-center gap-2 shadow-sm rounded-3 fw-bold mt-2">
                    <span>Sign In</span>
                    <i class="bi bi-arrow-right-circle-fill"></i>
                </button>
                
                <div class="mt-5 border-top pt-4">
                    <p class="text-muted small fw-bold text-center mb-3 text-uppercase">Demo Accounts</p>
                    <div class="row g-2 small text-center text-secondary">
                        <div class="col-6"><strong>admin@library.com</strong><br/>(admin)</div>
                        <div class="col-6"><strong>librarian@library.com</strong><br/>(librarian)</div>
                        <div class="col-6 mt-3"><strong>student@library.com</strong><br/>(student)</div>
                        <div class="col-6 mt-3"><strong>guest@library.com</strong><br/>(guest)</div>
                    </div>
                </div>
            </form>
        </div>
    </div>

</body>
</html>
