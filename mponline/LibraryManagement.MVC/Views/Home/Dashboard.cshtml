@model LibraryManagement.MVC.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header px-4">
    <div class="container-fluid p-0">
        <h1><i class="bi bi-grid-fill me-2"></i>Dashboard</h1>
        <p>Overview of library statistics and recent activities.</p>
    </div>
</div>

<div class="container-fluid px-4 pb-5">
    
    <!-- Summary Stats Row 1 (Core) -->
    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 d-flex flex-row align-items-center gap-3 border-0 shadow-sm rounded-4 h-100 stat-card" style="transition: transform 0.2s;">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:50px; height:50px; background:rgba(99,102,241,0.15); color:var(--primary);">
                    <i class="bi bi-collection-fill fs-4"></i>
                </div>
                <div>
                    <h3 class="fs-4 mb-0 fw-bold text-dark">@Model.TotalBooks</h3>
                    <p class="text-secondary small mb-0 fw-500">Total Books</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 d-flex flex-row align-items-center gap-3 border-0 shadow-sm rounded-4 h-100 stat-card" style="transition: transform 0.2s;">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:50px; height:50px; background:rgba(16,185,129,0.15); color:var(--success);">
                    <i class="bi bi-check-circle-fill fs-4"></i>
                </div>
                <div>
                    <h3 class="fs-4 mb-0 fw-bold text-dark">@Model.AvailableBooks</h3>
                    <p class="text-secondary small mb-0 fw-500">Available Books</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 d-flex flex-row align-items-center gap-3 border-0 shadow-sm rounded-4 h-100 stat-card" style="transition: transform 0.2s;">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:50px; height:50px; background:rgba(239,68,68,0.15); color:var(--danger);">
                    <i class="bi bi-book-half fs-4"></i>
                </div>
                <div>
                    <h3 class="fs-4 mb-0 fw-bold text-dark">@Model.BorrowedBooks</h3>
                    <p class="text-secondary small mb-0 fw-500">Issued Books</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 d-flex flex-row align-items-center gap-3 border-0 shadow-sm rounded-4 h-100 stat-card" style="transition: transform 0.2s;">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:50px; height:50px; background:rgba(99,102,241,0.15); color:var(--primary);">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
                <div>
                    <h3 class="fs-4 mb-0 fw-bold text-dark">@Model.TotalStudents</h3>
                    <p class="text-secondary small mb-0 fw-500">Students</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Stats Row 1.5 (New Entities) -->
    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 d-flex flex-row align-items-center gap-3 border-0 shadow-sm rounded-4 h-100 stat-card" style="transition: transform 0.2s;">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:50px; height:50px; background:rgba(236,72,153,0.15); color:var(--accent);">
                    <i class="bi bi-person-badge-fill fs-4"></i>
                </div>
                <div>
                    <h3 class="fs-4 mb-0 fw-bold text-dark">@Model.TotalLibrarians</h3>
                    <p class="text-secondary small mb-0 fw-500">Librarians</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 d-flex flex-row align-items-center gap-3 border-0 shadow-sm rounded-4 h-100 stat-card" style="transition: transform 0.2s;">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:50px; height:50px; background:rgba(245,158,11,0.15); color:var(--warning);">
                    <i class="bi bi-journal-text fs-4"></i>
                </div>
                <div>
                    <h3 class="fs-4 mb-0 fw-bold text-dark">@Model.TotalMagazines</h3>
                    <p class="text-secondary small mb-0 fw-500">Magazines</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 d-flex flex-row align-items-center gap-3 border-0 shadow-sm rounded-4 h-100 stat-card" style="transition: transform 0.2s;">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:50px; height:50px; background:rgba(16,185,129,0.15); color:var(--success);">
                    <i class="bi bi-newspaper fs-4"></i>
                </div>
                <div>
                    <h3 class="fs-4 mb-0 fw-bold text-dark">@Model.TotalNewspapers</h3>
                    <p class="text-secondary small mb-0 fw-500">Newspapers</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 d-flex flex-row align-items-center gap-3 border-0 shadow-sm rounded-4 h-100 stat-card" style="transition: transform 0.2s;">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:50px; height:50px; background:#f3e8ff; color:#9333ea;">
                    <i class="bi bi-journal-album fs-4"></i>
                </div>
                <div>
                    <h3 class="fs-4 mb-0 fw-bold text-dark">@Model.TotalPublications</h3>
                    <p class="text-secondary small mb-0 fw-500">Total Pubs</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Stats Row 2 (Today/Fines) -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 d-flex flex-row align-items-center gap-3 border-0 shadow-sm rounded-4 h-100 stat-card" style="transition: transform 0.2s;">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:50px; height:50px; background:#eff6ff; color:var(--primary);">
                    <i class="bi bi-calendar-check-fill fs-4"></i>
                </div>
                <div>
                    <h3 class="fs-4 mb-0 fw-bold text-dark">@Model.TodaysBorrowings</h3>
                    <p class="text-secondary small mb-0 fw-500">Today's Borrowings</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 d-flex flex-row align-items-center gap-3 border-0 shadow-sm rounded-4 h-100 stat-card" style="transition: transform 0.2s;">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:50px; height:50px; background:rgba(16,185,129,0.15); color:var(--success);">
                    <i class="bi bi-arrow-return-left fs-4"></i>
                </div>
                <div>
                    <h3 class="fs-4 mb-0 fw-bold text-dark">@Model.TodaysReturns</h3>
                    <p class="text-secondary small mb-0 fw-500">Today's Returns</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 d-flex flex-row align-items-center gap-3 border-0 shadow-sm rounded-4 h-100 stat-card" style="transition: transform 0.2s;">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:50px; height:50px; background:#fef2f2; color:var(--danger);">
                    <i class="bi bi-exclamation-octagon-fill fs-4"></i>
                </div>
                <div>
                    <h3 class="fs-4 mb-0 fw-bold text-dark">₹@Model.PendingFine</h3>
                    <p class="text-secondary small mb-0 fw-500">Pending Fine</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 d-flex flex-row align-items-center gap-3 border-0 shadow-sm rounded-4 h-100 stat-card" style="transition: transform 0.2s;">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:50px; height:50px; background:rgba(16,185,129,0.15); color:var(--success);">
                    <i class="bi bi-cash-stack fs-4"></i>
                </div>
                <div>
                    <h3 class="fs-4 mb-0 fw-bold text-dark">₹@Model.CollectedFine</h3>
                    <p class="text-secondary small mb-0 fw-500">Collected Fine</p>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Quick Actions & Recently Added Books -->
    <div class="row g-4 mb-4">
        <!-- Quick Actions -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-2">
                    <h5 class="fw-bold m-0"><i class="bi bi-lightning-fill text-warning me-2"></i>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-3">
                        <a asp-controller="Borrow" asp-action="Create" class="btn btn-primary rounded-3 text-start px-4 py-3 fw-bold shadow-sm d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-box-arrow-right me-2"></i> Issue Book</span>
                            <i class="bi bi-chevron-right"></i>
                        </a>
                        <a asp-controller="Student" asp-action="Create" class="btn btn-success rounded-3 text-start px-4 py-3 fw-bold shadow-sm d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-person-plus-fill me-2"></i> Add Student</span>
                            <i class="bi bi-chevron-right"></i>
                        </a>
                        <a asp-controller="Books" asp-action="Create" class="btn btn-info text-white rounded-3 text-start px-4 py-3 fw-bold shadow-sm d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-journal-plus me-2"></i> Add Book</span>
                            <i class="bi bi-chevron-right"></i>
                        </a>
                        <a asp-controller="Reports" asp-action="Index" class="btn btn-dark text-white rounded-3 text-start px-4 py-3 fw-bold shadow-sm d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-bar-chart-fill me-2"></i> Analytics & Reports</span>
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recently Added Books -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold m-0"><i class="bi bi-stars text-primary me-2"></i>Recently Added Books</h5>
                    <a asp-controller="Books" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill">View Catalog</a>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @foreach (var book in Model.FeaturedBooks.Take(3))
                        {
                            <div class="col-md-4">
                                <div class="card h-100 border rounded-3 bg-light bg-opacity-50">
                                    <div class="card-body text-center p-3">
                                        <div class="bg-white rounded-circle shadow-sm d-inline-flex align-items-center justify-content-center mb-3 text-primary" style="width:60px; height:60px;">
                                            <i class="bi bi-book-fill fs-3"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-1 text-truncate" title="@book.Title">@book.Title</h6>
                                        <p class="text-secondary small mb-2 text-truncate" title="@book.Author">@book.Author</p>
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">@book.Category</span>
                                    </div>
                                </div>
                            </div>
                        }
                        @if (!Model.FeaturedBooks.Any())
                        {
                            <div class="col-12 text-center text-muted py-4">
                                No books added recently.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Charts Section -->
    <div class="row g-4 mb-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Books vs Borrowed</h5>
                </div>
                <div class="card-body">
                    <canvas id="pieChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold"><i class="bi bi-graph-up text-success me-2"></i>Monthly Borrow Trend</h5>
                </div>
                <div class="card-body">
                    <canvas id="lineChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row g-4 mb-4">
        <!-- Bar Chart -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold"><i class="bi bi-bar-chart-fill text-warning me-2"></i>Library Resources</h5>
                </div>
                <div class="card-body">
                    <canvas id="barChart"></canvas>
                </div>
            </div>
        </div>
        
        <!-- Books Category Doughnut -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold"><i class="bi bi-tags-fill text-info me-2"></i>Top Categories</h5>
                </div>
                <div class="card-body">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Borrowings -->
    <div class="row g-4 mb-4">
        <div class="col-lg-12">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold m-0"><i class="bi bi-clock-history text-danger me-2"></i>Recent Borrowings</h5>
                    <a asp-controller="Borrow" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill">View All</a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Student</th>
                                    <th>Item</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in Model.RecentBorrows)
                                {
                                    var itemName = record.Book != null ? record.Book.Title : (record.Publication != null ? record.Publication.Title : "Unknown Item");
                                    <tr>
                                        <td class="fw-bold text-dark">@(record.Student?.Name ?? "Unknown")</td>
                                        <td class="text-secondary small">@itemName</td>
                                        <td>
                                            @if (record.ReturnDate.HasValue)
                                            {
                                                <span class="badge bg-success">Returned</span>
                                            }
                                            else if (DateTime.Today > record.DueDate)
                                            {
                                                <span class="badge bg-danger">Overdue</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Active</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (!Model.RecentBorrows.Any())
                                {
                                    <tr><td colspan="3" class="text-center text-muted">No recent borrowings.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Add hover effects for stat cards
            document.querySelectorAll('.stat-card').forEach(card => {
                card.addEventListener('mouseenter', () => card.style.transform = 'translateY(-5px)');
                card.addEventListener('mouseleave', () => card.style.transform = 'translateY(0)');
            });

            // 1. Books vs Borrowed (Pie Chart)
            new Chart(document.getElementById('pieChart'), {
                type: 'doughnut',
                data: {
                    labels: ['Available Books', 'Issued Books'],
                    datasets: [{
                        data: [@Model.AvailableBooks, @Model.BorrowedBooks],
                        backgroundColor: ['#10b981', '#ef4444'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { position: 'bottom' } }
                }
            });

            // 2. Library Resources (Bar Chart)
            new Chart(document.getElementById('barChart'), {
                type: 'bar',
                data: {
                    labels: ['Books', 'Magazines', 'Newspapers'],
                    datasets: [{
                        label: 'Total Count',
                        data: [@Model.TotalBooks, @Model.TotalMagazines, @Model.TotalNewspapers],
                        backgroundColor: ['#6366f1', '#f59e0b', '#ec4899'],
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    scales: { y: { beginAtZero: true } },
                    plugins: { legend: { display: false } }
                }
            });

            // 3. Monthly Borrow Trend (Line Chart - Real Data)
            var monthlyLabels = @Html.Raw(Json.Serialize(Model.MonthlyLabels));
            var monthlyData = @Html.Raw(Json.Serialize(Model.MonthlyBorrowCounts));
            
            new Chart(document.getElementById('lineChart'), {
                type: 'line',
                data: {
                    labels: monthlyLabels,
                    datasets: [{
                        label: 'Borrowings',
                        data: monthlyData,
                        borderColor: '#6366f1',
                        backgroundColor: 'rgba(99,102,241,0.1)',
                        borderWidth: 3,
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true } },
                    plugins: { legend: { display: false } }
                }
            });

            // 4. Books Category (Doughnut Chart - Real Data)
            var categoryLabels = @Html.Raw(Json.Serialize(Model.CategoryLabels));
            var categoryData = @Html.Raw(Json.Serialize(Model.CategoryCounts));
            
            new Chart(document.getElementById('categoryChart'), {
                type: 'doughnut',
                data: {
                    labels: categoryLabels,
                    datasets: [{
                        data: categoryData,
                        backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { position: 'right' } }
                }
            });
        });
    </script>
}
