@{
    ViewData["Title"] = "Welcome to Central Library";
}

<!-- Hero Section -->
<section class="bg-primary text-white py-5 position-relative overflow-hidden" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
    <div class="container position-relative py-5">
        <div class="row align-items-center text-center text-lg-start">
            <div class="col-lg-7 mb-5 mb-lg-0">
                <div class="d-flex align-items-center justify-content-center justify-content-lg-start mb-4">
                    <i class="bi bi-book-half fs-1 me-3 text-white"></i>
                    <h2 class="fw-bold mb-0 text-white">Central Library</h2>
                </div>
                <h1 class="display-4 fw-bold mb-4" style="line-height: 1.2;">
                    Your Gateway to <br/><span class="text-white-50">Infinite Knowledge</span>
                </h1>
                <p class="lead mb-4 text-white-50" style="font-size: 1.25rem;">
                    Discover, borrow, and manage knowledge seamlessly. A unified platform designed exclusively for modern students and librarians.
                </p>
                <div class="d-flex gap-3 justify-content-center justify-content-lg-start">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-light text-primary btn-lg fw-bold px-4 py-2 rounded-pill shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Login
                    </a>
                    <a href="#features" class="btn btn-outline-light btn-lg px-4 py-2 rounded-pill shadow-sm">
                        Explore Library
                    </a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block text-center">
                <img src="https://ui-avatars.com/api/?name=Central+Library&background=fff&color=0d6efd&rounded=true&size=300" alt="Library Logo" class="img-fluid floating-animation shadow-lg" style="border-radius: 50%; border: 8px solid rgba(255,255,255,0.2);" />
            </div>
        </div>
    </div>
</section>

<!-- Featured Books Section -->
<section id="featured-books" class="py-5 bg-white">
    <div class="container py-4">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-primary">Featured Books</h2>
            <p class="text-muted">Discover our most popular and highly rated additions.</p>
        </div>
        <div class="row g-4">
            <!-- Static Placeholders since we can't modify business logic -->
            <div class="col-md-3">
                <div class="card h-100 border-0 shadow-sm rounded-4 text-center hover-lift">
                    <div class="card-body p-4">
                        <div class="bg-primary bg-opacity-10 text-primary p-4 rounded-3 mb-3 mx-auto" style="width: 80px;">
                            <i class="bi bi-book fs-1"></i>
                        </div>
                        <h5 class="fw-bold text-dark">Clean Code</h5>
                        <p class="small text-muted mb-0">Robert C. Martin</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 border-0 shadow-sm rounded-4 text-center hover-lift">
                    <div class="card-body p-4">
                        <div class="bg-primary bg-opacity-10 text-primary p-4 rounded-3 mb-3 mx-auto" style="width: 80px;">
                            <i class="bi bi-journal-code fs-1"></i>
                        </div>
                        <h5 class="fw-bold text-dark">The Pragmatic Programmer</h5>
                        <p class="small text-muted mb-0">Andrew Hunt</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 border-0 shadow-sm rounded-4 text-center hover-lift">
                    <div class="card-body p-4">
                        <div class="bg-primary bg-opacity-10 text-primary p-4 rounded-3 mb-3 mx-auto" style="width: 80px;">
                            <i class="bi bi-layout-wtf fs-1"></i>
                        </div>
                        <h5 class="fw-bold text-dark">Design Patterns</h5>
                        <p class="small text-muted mb-0">Erich Gamma</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 border-0 shadow-sm rounded-4 text-center hover-lift">
                    <div class="card-body p-4">
                        <div class="bg-primary bg-opacity-10 text-primary p-4 rounded-3 mb-3 mx-auto" style="width: 80px;">
                            <i class="bi bi-code-slash fs-1"></i>
                        </div>
                        <h5 class="fw-bold text-dark">Refactoring</h5>
                        <p class="small text-muted mb-0">Martin Fowler</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Library Features Section -->
<section id="features" class="py-5 bg-light">
    <div class="container py-4">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-primary">Library Features</h2>
            <p class="text-muted">A powerful suite of tools to manage your resources efficiently.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 text-center p-4 hover-lift">
                    <div class="mb-3">
                        <div class="d-inline-block bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                            <i class="bi bi-search fs-1"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold">Smart Search</h4>
                    <p class="text-muted mb-0">Instantly find books, magazines, and newspapers across the entire catalog.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 text-center p-4 hover-lift">
                    <div class="mb-3">
                        <div class="d-inline-block bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                            <i class="bi bi-phone-fill fs-1"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold">Mobile Ready</h4>
                    <p class="text-muted mb-0">Access your library dashboard on any device with our fully responsive design.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 text-center p-4 hover-lift">
                    <div class="mb-3">
                        <div class="d-inline-block bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                            <i class="bi bi-graph-up fs-1"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold">Real-time Stats</h4>
                    <p class="text-muted mb-0">Monitor borrowing trends, fine collections, and inventory at a glance.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Statistics Section -->
<section class="py-5 bg-white border-top border-bottom">
    <div class="container py-3">
        <div class="row text-center g-4">
            <div class="col-6 col-md-3">
                <h2 class="display-5 fw-bold text-primary mb-0">10k+</h2>
                <p class="text-muted fw-500 text-uppercase small">Books</p>
            </div>
            <div class="col-6 col-md-3">
                <h2 class="display-5 fw-bold text-primary mb-0">5k+</h2>
                <p class="text-muted fw-500 text-uppercase small">Students</p>
            </div>
            <div class="col-6 col-md-3">
                <h2 class="display-5 fw-bold text-primary mb-0">15+</h2>
                <p class="text-muted fw-500 text-uppercase small">Departments</p>
            </div>
            <div class="col-6 col-md-3">
                <h2 class="display-5 fw-bold text-primary mb-0">24/7</h2>
                <p class="text-muted fw-500 text-uppercase small">Digital Access</p>
            </div>
        </div>
    </div>
</section>

<!-- Announcements Section -->
<section class="py-5 bg-light">
    <div class="container py-4">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-primary">Latest Announcements</h2>
            <p class="text-muted">Stay up to date with library events and notices.</p>
        </div>
        <div class="row g-4 justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 mb-3 border-start border-primary border-4 hover-lift">
                    <div class="card-body p-4 d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle me-4">
                            <i class="bi bi-megaphone-fill fs-3"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1 text-dark">Extended Exam Hours</h5>
                            <p class="text-muted mb-0">The library will remain open until midnight during the final exam weeks.</p>
                        </div>
                    </div>
                </div>
                <div class="card border-0 shadow-sm rounded-4 border-start border-primary border-4 hover-lift">
                    <div class="card-body p-4 d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle me-4">
                            <i class="bi bi-journal-bookmark-fill fs-3"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1 text-dark">New Digital Archives</h5>
                            <p class="text-muted mb-0">We have partnered with leading digital publishers to bring 1,000+ new magazines online.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- About & Contact Section -->
<section class="py-5 bg-white">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <h2 class="fw-bold text-primary mb-3">About Central Library</h2>
                <p class="text-muted lead mb-4">Dedicated to providing the best knowledge resources for our community, offering an extensive collection of books, digital magazines, and national newspapers.</p>
                <ul class="list-unstyled mb-4">
                    <li class="mb-3 d-flex align-items-center"><i class="bi bi-check-circle-fill text-primary me-3 fs-5"></i> <span class="fw-500 text-dark">Modern study spaces with Wi-Fi</span></li>
                    <li class="mb-3 d-flex align-items-center"><i class="bi bi-check-circle-fill text-primary me-3 fs-5"></i> <span class="fw-500 text-dark">Extensive digital catalog access</span></li>
                    <li class="mb-3 d-flex align-items-center"><i class="bi bi-check-circle-fill text-primary me-3 fs-5"></i> <span class="fw-500 text-dark">Fully automated borrowing system</span></li>
                </ul>
            </div>
            <div class="col-lg-5 offset-lg-1">
                <div class="card border-0 shadow-lg rounded-4 bg-primary text-white">
                    <div class="card-body p-5">
                        <h3 class="fw-bold mb-4">Contact Us</h3>
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-geo-alt-fill fs-4 me-3 text-white-50"></i>
                            <span>123 University Campus, Academic Block A</span>
                        </div>
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-envelope-fill fs-4 me-3 text-white-50"></i>
                            <span>library@university.edu</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="bi bi-telephone-fill fs-4 me-3 text-white-50"></i>
                            <span>+1 (555) 123-4567</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Footer -->
<footer class="bg-dark text-center text-white-50 py-4">
    <div class="container">
        <p class="mb-0">&copy; @DateTime.Now.Year <span class="text-white">Central Library</span>. All rights reserved.</p>
    </div>
</footer>

<style>
    .floating-animation {
        animation: float 6s ease-in-out infinite;
    }
    @@keyframes float {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-15px); }
        100% { transform: translateY(0px); }
    }
    .hover-lift {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .hover-lift:hover {
        transform: translateY(-8px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.15)!important;
    }
    body { background: #fff !important; }
</style>
