<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] – Library Management System</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" defer></script>
  
</head>
<body>
  @if (User.Identity.IsAuthenticated)
  {
      <div class="app-wrapper">
        <!-- LEFT SIDEBAR -->
        <aside class="sidebar" id="mainSidebar">
          <a asp-controller="Home" asp-action="Dashboard" class="sidebar-header">
            <i class="bi bi-layers-half text-primary"></i> LibraryAdmin
          </a>
          <div class="sidebar-nav pb-4">
            
            <div class="nav-item">
                <a asp-controller="Home" asp-action="Dashboard" class="sidebar-link">
                    <i class="bi bi-grid-1x2-fill"></i> Dashboard
                </a>
            </div>

            <!-- Library Collapsible -->
            <div class="nav-item">
                <a class="sidebar-link" data-bs-toggle="collapse" href="#libraryMenu" role="button" aria-expanded="false" aria-controls="libraryMenu">
                    <i class="bi bi-collection-fill"></i> Library
                    <i class="bi bi-chevron-down chevron-icon"></i>
                </a>
                <div class="collapse sidebar-submenu" id="libraryMenu">
                    <a asp-controller="Books" asp-action="Index" class="sidebar-link">Books</a>
                    <a asp-controller="Magazines" asp-action="Index" class="sidebar-link">Magazines</a>
                    <a asp-controller="Newspapers" asp-action="Index" class="sidebar-link">Newspapers</a>
                </div>
            </div>

            <!-- Users Collapsible -->
            <div class="nav-item">
                <a class="sidebar-link" data-bs-toggle="collapse" href="#usersMenu" role="button" aria-expanded="false" aria-controls="usersMenu">
                    <i class="bi bi-people-fill"></i> Users
                    <i class="bi bi-chevron-down chevron-icon"></i>
                </a>
                <div class="collapse sidebar-submenu" id="usersMenu">
                    <a asp-controller="Student" asp-action="Index" class="sidebar-link">Students</a>
                    <a asp-controller="Librarian" asp-action="Index" class="sidebar-link">Librarians</a>
                </div>
            </div>

            <!-- Transactions Collapsible -->
            <div class="nav-item">
                <a class="sidebar-link" data-bs-toggle="collapse" href="#transactionsMenu" role="button" aria-expanded="false" aria-controls="transactionsMenu">
                    <i class="bi bi-arrow-left-right"></i> Transactions
                    <i class="bi bi-chevron-down chevron-icon"></i>
                </a>
                <div class="collapse sidebar-submenu" id="transactionsMenu">
                    <a asp-controller="Borrow" asp-action="Create" class="sidebar-link">Borrow</a>
                    <a asp-controller="Borrow" asp-action="Index" class="sidebar-link">Return</a>
                    <a asp-controller="Borrow" asp-action="Index" class="sidebar-link">Borrow History</a>
                </div>
            </div>

            <!-- Finance Collapsible -->
            <div class="nav-item">
                <a class="sidebar-link" data-bs-toggle="collapse" href="#financeMenu" role="button" aria-expanded="false" aria-controls="financeMenu">
                    <i class="bi bi-cash-stack"></i> Finance
                    <i class="bi bi-chevron-down chevron-icon"></i>
                </a>
                <div class="collapse sidebar-submenu" id="financeMenu">
                    <a asp-controller="Fines" asp-action="Index" class="sidebar-link">Fine Management</a>
                </div>
            </div>

            <div class="nav-item mt-2">
                <a asp-controller="Reports" asp-action="Index" class="sidebar-link">
                    <i class="bi bi-bar-chart-fill"></i> Reports
                </a>
            </div>

            <div class="nav-item">
                <a href="#" class="sidebar-link">
                    <i class="bi bi-gear-fill"></i> Settings
                </a>
            </div>

            <div class="mt-auto"></div>
            <div class="nav-item border-top border-secondary border-opacity-25 mt-3 pt-2">
                <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="d-none"></form>
                <a href="#" onclick="document.getElementById('logoutForm').submit();" class="sidebar-link text-danger hover-danger">
                    <i class="bi bi-box-arrow-left"></i> Logout
                </a>
            </div>
          </div>
        </aside>

        <!-- OVERLAY FOR MOBILE -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- MAIN CONTENT -->
        <div class="main-content">
          <header class="top-header">
            <button class="sidebar-toggle" id="sidebarToggle">
              <i class="bi bi-list"></i>
            </button>
            <div class="d-flex align-items-center gap-3">
              <form class="search-wrapper d-none d-md-block position-relative" asp-controller="Search" asp-action="Index" method="get">
                <i class="bi bi-search"></i>
                <input type="text" name="query" class="form-control form-control-sm" placeholder="Search anything..." style="width:240px;">
              </form>
              <div class="d-flex align-items-center gap-2" style="cursor:pointer;">
                <img src="https://ui-avatars.com/api/?name=@(User.Identity.Name ?? "Admin")&background=2563eb&color=fff" class="rounded-circle border border-2" style="border-color:rgba(255,255,255,0.15)!important;" width="34" height="34" alt="Admin">
                <span class="d-none d-sm-inline fw-semibold small">@(User.Identity.Name ?? "Admin")</span>
              </div>
            </div>
          </header>

          @RenderBody()

          <footer class="px-4 py-3">
            <div class="d-flex justify-content-between align-items-center">
              <span class="text-muted small"><i class="bi bi-book-half me-1 text-primary"></i>Library Management System &copy; @DateTime.Now.Year</span>
              <span class="text-muted small">MVC Admin Portal v2.0</span>
            </div>
          </footer>
        </div>
      </div>
  }
  else
  {
      // Unauthenticated Layout (Landing Page, Login)
      @RenderBody()
  }

  <!-- Global Spinner -->
  <div id="global-spinner" class="hidden">
    <div class="spinner-ring"></div>
    <p>Loading…</p>
  </div>

  <!-- Toast Container -->
  <div id="toast-container"></div>

  <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/app.js" asp-append-version="true"></script>
  @RenderSection("Scripts", required: false)
</body>
</html>
