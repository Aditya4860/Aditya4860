<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] – Library Management System</title>
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  
  <style>
    :root {
      --primary: #6366f1;
      --secondary: #64748b;
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;
      --dark: #1e293b;
      --bg-color: #f8fafc;
      --accent: #ec4899;
    }
    body {
      background-color: var(--bg-color);
      font-family: 'Inter', -apple-system, sans-serif;
      overflow-x: hidden;
    }
    .app-wrapper { display: flex; height: 100vh; overflow: hidden; }
    
    /* Sidebar */
    .sidebar {
      width: 260px;
      background: #fff;
      border-right: 1px solid #e2e8f0;
      display: flex;
      flex-direction: column;
      transition: transform 0.3s ease;
      z-index: 1040;
    }
    .sidebar-header {
      padding: 1.5rem;
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--primary);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      border-bottom: 1px solid #e2e8f0;
    }
    .sidebar-nav {
      padding: 1rem 0;
      overflow-y: auto;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }
    .sidebar-link {
      padding: 0.75rem 1.5rem;
      color: var(--secondary);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 1rem;
      font-weight: 500;
      transition: all 0.2s;
    }
    .sidebar-link:hover, .sidebar-link.active {
      color: var(--primary);
      background: rgba(99,102,241,0.05);
      border-right: 3px solid var(--primary);
    }
    .sidebar-link i { font-size: 1.1rem; }
    
    /* Main Content */
    .main-content {
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
    }
    .top-header {
      background: #fff;
      padding: 1rem 1.5rem;
      border-bottom: 1px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 1030;
    }
    .sidebar-toggle {
      border: none;
      background: none;
      font-size: 1.5rem;
      color: var(--dark);
      cursor: pointer;
      display: none;
    }
    
    /* Pages */
    .page-header {
      background: #fff;
      padding: 1.5rem 0;
      margin-bottom: 2rem;
      border-bottom: 1px solid #e2e8f0;
    }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--dark); }
    .page-header p { margin: 0; color: var(--secondary); font-size: 0.95rem; }
    
    /* Mobile overlay */
    .sidebar-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.5);
      z-index: 1035;
      display: none;
      opacity: 0;
      transition: opacity 0.3s;
    }
    
    @@media (max-width: 768px) {
      .sidebar { position: fixed; height: 100%; transform: translateX(-100%); }
      .sidebar.show { transform: translateX(0); }
      .sidebar-toggle { display: block; }
      .sidebar-overlay.show { display: block; opacity: 1; }
    }
  </style>
</head>
<body>
  <div class="app-wrapper">
    <!-- LEFT SIDEBAR -->
    <aside class="sidebar" id="mainSidebar">
      <a asp-controller="Home" asp-action="Index" class="sidebar-header">
        <i class="bi bi-book-half"></i> LibraryMS
      </a>
      <div class="sidebar-nav">
        <a asp-controller="Home" asp-action="Index" class="sidebar-link"><i class="bi bi-grid"></i> Dashboard</a>
        <a asp-controller="Books" asp-action="Index" class="sidebar-link"><i class="bi bi-book"></i> Books</a>
        <a asp-controller="Student" asp-action="Index" class="sidebar-link"><i class="bi bi-people"></i> Students</a>
        <a asp-controller="Librarian" asp-action="Index" class="sidebar-link"><i class="bi bi-person-badge"></i> Librarians</a>
        <a asp-controller="Publications" asp-action="Index" asp-route-type="Newspaper" class="sidebar-link"><i class="bi bi-newspaper"></i> Newspapers</a>
        <a asp-controller="Publications" asp-action="Index" asp-route-type="Magazine" class="sidebar-link"><i class="bi bi-journal-text"></i> Magazines</a>
        <a asp-controller="Borrow" asp-action="Index" class="sidebar-link"><i class="bi bi-arrow-left-right"></i> Borrow</a>
        <a asp-controller="Fines" asp-action="Index" class="sidebar-link"><i class="bi bi-cash-stack"></i> Fine</a>
        
        <div class="mt-auto"></div>
        <hr class="border-secondary opacity-25 mx-3 my-2">
        <a asp-controller="Account" asp-action="Login" class="sidebar-link"><i class="bi bi-box-arrow-in-right"></i> Login</a>
        <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="d-none"></form>
        <a href="#" onclick="document.getElementById('logoutForm').submit();" class="sidebar-link text-danger"><i class="bi bi-box-arrow-left"></i> Logout</a>
      </div>
    </aside>

    <!-- OVERLAY FOR MOBILE -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- MAIN CONTENT -->
    <div class="main-content">
      <header class="top-header">
        <button class="sidebar-toggle" id="sidebarToggle">
          <i class="bi bi-list"></i>
        </button>
        <div class="d-flex align-items-center gap-3">
          <form class="search-wrapper d-none d-md-block position-relative" asp-controller="Search" asp-action="Index" method="get">
            <i class="bi bi-search position-absolute" style="left: 10px; top: 50%; transform: translateY(-50%); color: #6c757d;"></i>
            <input type="text" name="query" class="form-control form-control-sm" placeholder="Global Search..." style="width: 250px; padding-left:30px;">
          </form>
          <div class="text-white d-flex align-items-center gap-2">
            <img src="https://ui-avatars.com/api/?name=Admin&background=6366f1&color=fff" class="rounded-circle" width="32" height="32" alt="Admin">
            <span class="d-none d-sm-inline fw-bold text-dark">Admin</span>
          </div>
        </div>
      </header>

      @RenderBody()

      <footer class="mt-auto px-4 py-3 bg-white border-top">
        <div class="d-flex justify-content-between align-items-center">
          <span class="text-muted small"><i class="bi bi-book-half me-1 text-primary"></i>Library Management System &copy; 2026</span>
          <span class="text-muted small">MVC Dashboard</span>
        </div>
      </footer>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const sidebar = document.getElementById('mainSidebar');
      const overlay = document.getElementById('sidebarOverlay');
      const toggleBtn = document.getElementById('sidebarToggle');
      if(toggleBtn) {
          toggleBtn.addEventListener('click', () => {
            sidebar.classList.toggle('show');
            overlay.classList.toggle('show');
          });
      }
      if(overlay) {
          overlay.addEventListener('click', () => {
            sidebar.classList.remove('show');
            overlay.classList.remove('show');
          });
      }
      
      // Auto-highlight active nav link
      const currentUrl = window.location.pathname.toLowerCase();
      document.querySelectorAll('.sidebar-link').forEach(link => {
          if (link.getAttribute('href') && currentUrl.includes(link.getAttribute('href').toLowerCase()) && link.getAttribute('href') !== '/') {
              link.classList.add('active');
          }
      });
    });
  </script>
  @RenderSection("Scripts", required: false)
</body>
</html>
