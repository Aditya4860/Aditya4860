@model LibraryManagement.MVC.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-trash text-danger me-2"></i>Delete Book</h1>
        <p class="text-danger fw-bold">Are you sure you want to delete this book? This action cannot be undone.</p>
    </div>
</div>

<main class="container page-wrapper">
    <div class="card shadow-sm border-danger col-md-8 mx-auto">
        <div class="card-body p-4">
            <h4 class="card-title mb-4">@Model.Title</h4>
            
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Author)</dt>
                <dd class="col-sm-8 fw-bold">@Html.DisplayFor(model => model.Author)</dd>

                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.ISBN)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.ISBN)</dd>

                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Category)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Category)</dd>
            </dl>
        </div>
        <div class="card-footer bg-white p-4 d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Cancel</a>
            <form asp-action="Delete" asp-route-id="@Model.Id">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete Book</button>
            </form>
        </div>
    </div>
</main>
