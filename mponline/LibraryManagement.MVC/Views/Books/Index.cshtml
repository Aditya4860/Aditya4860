@model LibraryManagement.MVC.ViewModels.BookListViewModel

@{
    ViewData["Title"] = "Books";
}

<!-- Page Header (assuming Layout handles Sidebar and Top Header) -->
<div class="page-header px-4">
    <div class="container-fluid p-0">
        <h1><i class="bi bi-book me-2"></i>Library Books</h1>
        <p>Manage the library book collection.</p>
    </div>
</div>

<main class="container-fluid px-4 pb-5 page-wrapper">

    <div class="card shadow-sm border mb-4">
        <div class="card-header bg-white pt-3 pb-2 border-bottom-0 d-flex justify-content-between align-items-center">
            <span class="fw-bold fs-5"><i class="bi bi-journal-album text-primary me-2"></i>Books List</span>
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add Book</a>
        </div>
        <div class="card-body p-3">
            <!-- Search Form -->
            <form method="get" asp-action="Index" class="mb-4">
                <div class="row g-2">
                    <div class="col-md-9">
                        <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control form-control-sm" placeholder="Search by Title, Author, ISBN, or Category..." />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-search"></i> Search</button>
                    </div>
                </div>
            </form>

            <div class="table-responsive table-wrapper border">
                <table class="table table-hover align-middle mb-0" id="booksTable">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Title</th>
                            <th scope="col">Author</th>
                            <th scope="col">ISBN</th>
                            <th scope="col">Category</th>
                            <th scope="col">Copies</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Books.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-3">No books found.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var book in Model.Books)
                            {
                                <tr>
                                    <td>@book.Id</td>
                                    <td class="fw-bold">@book.Title</td>
                                    <td>@book.Author</td>
                                    <td><span class="font-monospace text-muted small">@book.ISBN</span></td>
                                    <td>@book.Category</td>
                                    <td>@book.AvailableCopies / @book.TotalCopies</td>
                                    <td>
                                        @if (book.AvailableCopies == 0)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">Issued</span>
                                        }
                                        else if (book.AvailableCopies < book.TotalCopies)
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">Issued (@(book.TotalCopies - book.AvailableCopies))</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Available</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            @if (book.AvailableCopies > 0)
                                            {
                                                <a asp-controller="Borrow" asp-action="Create" asp-route-bookId="@book.Id" class="btn btn-outline-primary" title="Borrow"><i class="bi bi-box-arrow-right"></i></a>
                                            }
                                            @if (book.AvailableCopies < book.TotalCopies)
                                            {
                                                <a asp-controller="Borrow" asp-action="Index" asp-route-searchQuery="@book.Title" asp-route-filterStatus="active" class="btn btn-outline-success" title="Return"><i class="bi bi-arrow-return-left"></i></a>
                                            }
                                            <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                                            <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-outline-info" title="Details"><i class="bi bi-info-circle"></i></a>
                                            <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Server-Side Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav class="mt-4 d-flex justify-content-between align-items-center">
                    <span class="text-muted small">Page @Model.CurrentPage of @Model.TotalPages</span>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@(Model.CurrentPage - 1)" 
                               asp-route-searchQuery="@Model.SearchQuery">Previous</a>
                        </li>
                        
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@i" 
                                   asp-route-searchQuery="@Model.SearchQuery">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@(Model.CurrentPage + 1)" 
                               asp-route-searchQuery="@Model.SearchQuery">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>

</main>
