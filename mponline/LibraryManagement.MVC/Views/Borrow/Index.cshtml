@model LibraryManagement.MVC.ViewModels.BorrowIndexViewModel

@{
    ViewData["Title"] = "Borrow History";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-clock-history me-2"></i>Borrow History</h1>
        <p>View all past and current borrowing records.</p>
    </div>
</div>

<main class="container page-wrapper">
    <!-- Toolbar -->
    <div class="card mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-6">
                    <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control" placeholder="Search by student or item title..." />
                </div>
                <div class="col-md-3">
                    <select name="filterStatus" class="form-select">
                        <option value="all" selected="@(Model.FilterStatus == "all" || string.IsNullOrEmpty(Model.FilterStatus))">All Records</option>
                        <option value="active" selected="@(Model.FilterStatus == "active")">Currently Borrowed</option>
                        <option value="returned" selected="@(Model.FilterStatus == "returned")">Returned</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-secondary flex-grow-1"><i class="bi bi-search"></i> Search</button>
                    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Issue Item</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Borrow Table -->
    <div class="table-wrapper border shadow-sm mb-5">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Student</th>
                    <th scope="col">Item Borrowed</th>
                    <th scope="col">Borrow Date</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.BorrowRecords.Any())
                {
                    <tr>
                        <td colspan="6" class="table-no-results py-5 text-center">
                            <i class="bi bi-clock-history fs-2 d-block mb-3 text-muted"></i>
                            <p class="mb-0 fw-bold">No borrow records found matching your criteria.</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var record in Model.BorrowRecords)
                    {
                        var itemName = record.Book != null ? record.Book.Title : (record.Publication != null ? record.Publication.Title : "Unknown Item");
                        var itemType = record.Book != null ? "Book" : (record.Publication != null ? record.Publication.Type.ToString() : "");
                        
                        <tr>
                            <td class="text-muted fw-bold">@record.Id</td>
                            <td>
                                <div class="fw-bold text-dark">@record.Student?.Name</div>
                                <small class="text-muted">@record.Student?.EnrollmentNo</small>
                            </td>
                            <td>
                                <div class="fw-bold text-secondary">@itemName</div>
                                <small class="badge bg-light text-dark border">@itemType</small>
                            </td>
                            <td>
                                <div><small class="text-muted">Out:</small> @record.BorrowDate.ToShortDateString()</div>
                                <div><small class="text-muted">Due:</small> @record.DueDate.ToShortDateString()</div>
                            </td>
                            <td>
                                @if (record.ReturnDate.HasValue)
                                {
                                    <span class="badge bg-success">Returned @record.ReturnDate.Value.ToShortDateString()</span>
                                }
                                else if (DateTime.Today > record.DueDate)
                                {
                                    <span class="badge bg-danger">Overdue!</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Active</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (!record.ReturnDate.HasValue)
                                {
                                    <form asp-action="Return" asp-route-id="@record.Id" method="post" class="d-flex flex-column gap-2 align-items-center">
                                        <select name="returnedByLibrarianId" class="form-select form-select-sm" required asp-items="Model.LibrariansList">
                                            <option value="">-- Librarian --</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary fw-bold w-100" onclick="return confirm('Confirm return for this item?');">
                                            <i class="bi bi-arrow-return-left"></i> Return
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">Completed</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4 d-flex justify-content-between align-items-center">
            <span class="text-muted small">Page @Model.CurrentPage of @Model.TotalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-page="@(Model.CurrentPage - 1)" 
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-filterStatus="@Model.FilterStatus">Previous</a>
                </li>
                
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@i" 
                           asp-route-searchQuery="@Model.SearchQuery"
                           asp-route-filterStatus="@Model.FilterStatus">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-page="@(Model.CurrentPage + 1)" 
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-filterStatus="@Model.FilterStatus">Next</a>
                </li>
            </ul>
        </nav>
    }
</main>
