@model LibraryManagement.MVC.ViewModels.NewspaperIndexViewModel

@{
    ViewData["Title"] = "Newspapers";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-newspaper me-2"></i>Newspapers</h1>
        <p>Manage library newspapers.</p>
    </div>
</div>

<main class="container page-wrapper">
    <!-- Toolbar -->
    <div class="card mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-9">
                    <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control" placeholder="Search by Title, Publisher, Edition, or Language..." />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-secondary flex-grow-1"><i class="bi bi-search"></i> Search</button>
                    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add New</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Newspapers Table -->
    <div class="table-responsive table-wrapper border shadow-sm mb-5">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Title</th>
                    <th scope="col">Publisher</th>
                    <th scope="col">Edition</th>
                    <th scope="col">Language</th>
                    <th scope="col">Date</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Newspapers.Any())
                {
                    <tr>
                        <td colspan="8" class="table-no-results py-5 text-center">
                            <i class="bi bi-search fs-2 d-block mb-3 text-muted"></i>
                            <p class="mb-0 fw-bold">No newspapers found matching your criteria.</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Newspapers)
                    {
                        <tr>
                            <td class="text-muted fw-bold">@item.NewspaperId</td>
                            <td class="fw-bold text-dark">@item.Title</td>
                            <td>@item.Publisher</td>
                            <td><span class="badge" style="background:#ecfdf5;color:var(--success);">@(string.IsNullOrEmpty(item.Edition) ? "Daily" : item.Edition)</span></td>
                            <td>@item.Language</td>
                            <td>@item.PublishedDate.ToShortDateString()</td>
                            <td>
                                @if(item.Availability)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Available</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">Unavailable</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.NewspaperId" class="btn btn-primary" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.NewspaperId" class="btn btn-success" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.NewspaperId" class="btn btn-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4 d-flex justify-content-between align-items-center">
            <span class="text-muted small">Page @Model.CurrentPage of @Model.TotalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-page="@(Model.CurrentPage - 1)" 
                       asp-route-searchQuery="@Model.SearchQuery">Previous</a>
                </li>
                
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@i" 
                           asp-route-searchQuery="@Model.SearchQuery">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-page="@(Model.CurrentPage + 1)" 
                       asp-route-searchQuery="@Model.SearchQuery">Next</a>
                </li>
            </ul>
        </nav>
    }
</main>
