@model LibraryManagement.MVC.ViewModels.LibrarianIndexViewModel

@{
    ViewData["Title"] = "Librarians";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-person-badge-fill me-2"></i>Librarians</h1>
        <p>Manage library staff and librarians.</p>
    </div>
</div>

<main class="container page-wrapper">
    <!-- Toolbar -->
    <div class="card mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-9">
                    <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control" placeholder="Search by Name, Employee ID, Email, or Phone..." />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-secondary flex-grow-1"><i class="bi bi-search"></i> Search</button>
                    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Librarian</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Librarian Table -->
    <div class="table-responsive table-wrapper border shadow-sm mb-5">
        <table class="table table-hover align-middle mb-0" id="librariansTable">
            <thead class="table-light">
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Employee ID</th>
                    <th scope="col">Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Phone</th>
                    <th scope="col">Shift</th>
                    <th scope="col" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Librarians.Any())
                {
                    <tr>
                        <td colspan="7" class="table-no-results py-5 text-center">
                            <i class="bi bi-search fs-2 d-block mb-3 text-muted"></i>
                            <p class="mb-0 fw-bold">No librarians found matching your criteria.</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var lib in Model.Librarians)
                    {
                        <tr>
                            <td class="text-muted fw-bold">@lib.Id</td>
                            <td><code class="text-primary">@lib.EmployeeId</code></td>
                            <td class="fw-bold text-dark">@lib.Name</td>
                            <td>@lib.Email</td>
                            <td class="text-secondary">@lib.Phone</td>
                            <td><span class="badge bg-info text-dark">@lib.Shift</span></td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@lib.Id" class="btn btn-primary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@lib.Id" class="btn btn-success" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@lib.Id" class="btn btn-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4 d-flex justify-content-between align-items-center">
            <span class="text-muted small">Page @Model.CurrentPage of @Model.TotalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-page="@(Model.CurrentPage - 1)" 
                       asp-route-searchQuery="@Model.SearchQuery">Previous</a>
                </li>
                
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@i" 
                           asp-route-searchQuery="@Model.SearchQuery">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-page="@(Model.CurrentPage + 1)" 
                       asp-route-searchQuery="@Model.SearchQuery">Next</a>
                </li>
            </ul>
        </nav>
    }
</main>
